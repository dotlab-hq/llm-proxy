{
  "name": "ai-edge",
  "version": "1.0.72",
  "description": "Local LLM routing server with OpenAI compatibility",
  "type": "module",
  "bin": {
    "ai-edge": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "scripts/patch-bson.cjs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotlab-hq/ai-edge.git"
  },
  "scripts": {
    "start": "node dist/server.js",
    "postinstall": "node scripts/patch-bson.cjs",
    "dev": "AI_EDGE_DEBUG=1 bun run --hot src/dev.ts",
    "cli": "node dist/cli.js",
    "build": "bun build src/cli/index.ts --outfile dist/cli.js --target node --external onnxruntime-node && bun build src/dev.ts --outfile dist/server.js --target node --external onnxruntime-node",
    "link": "bun link",
    "generate:schema": "bun scripts/schema-generate.ts",
    "generate:schema:path:local": "bun scripts/schema-local-path.ts",
    "typecheck": "bun tsc --noEmit",
    "testify": "bun test tests/prod.test.ts"
  },
  "keywords": [
    "llm",
    "proxy",
    "openai",
    "api"
  ],
  "author": "Wpsadi",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@clack/prompts": "^1.3.0",
    "@hono/node-server": "^2.0.1",
    "@hono/zod-openapi": "^1.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/daytona": "^0.2.0",
    "@langchain/exa": "^1.0.1",
    "@langchain/tavily": "^1.2.0",
    "ai-edge": ".",
    "chalk": "^5.6.2",
    "hono": "^4.12.16",
    "ioredis": "^5.10.1",
    "json5": "^2.2.3",
    "langchain": "^1.4.0",
    "mongodb": "^7.4.0",
    "undici": "^7.14.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "protobufjs"
  ]
}